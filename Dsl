local function LoadPets()
	for _, v in pairs(ScrollingFrame:GetChildren()) do
		if v:IsA("TextButton") then v:Destroy() end
	end
	
	local Stats = workspace.__REMOTES.Core["Get Stats"]:InvokeServer()
	local Pets = Stats.Save.Pets
	table.sort(Pets, function(a, b) return tonumber(a.xp) > tonumber(b.xp) end)
	
	local function formatNumber(number)
		if not number then return 'nil' end
		local formatted = tostring(number)
		while true do
			formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", '%1,%2')
			if k == 0 then break end
		end
		return formatted
	end

	for _, v in pairs(Pets) do
		local b = Instance.new('TextButton', ScrollingFrame)
		local prefix = v.dm and v.r and 'Glitched' or v.dm and 'Dark Matter' or v.r and 'Rainbow' or v.g and 'Gold' or 'Regular'
		
		local petData = PetDir[tostring(v.n)]
		local petName = petData and petData.DisplayName or tostring(v.n)
		
		b.Text = ' ' .. formatNumber(v.l) .. ' | ' .. prefix .. ' ' .. petName
		b.Font = Enum.Font.GothamBold
		b.TextSize = 12
		b.BackgroundColor3 = selected_Pets[v.id] and Color3.fromRGB(0, 123, 255) or Color3.fromRGB(45, 45, 45)
		b.TextXAlignment = Enum.TextXAlignment.Left
		b.TextColor3 = Color3.fromRGB(218, 218, 218)
		b.Name = v.id
		b.Size = UDim2.new(1, -10, 0, 30)
		b.AutoButtonColor = false
		Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)

		b.MouseButton1Click:Connect(function()
			if selected_Pets[v.id] then
				selected_Pets[v.id] = nil
				b.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
			else
				selected_Pets[v.id] = true
				b.BackgroundColor3 = Color3.fromRGB(0, 123, 255)
			end
		end)
	end
	
	ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
end

