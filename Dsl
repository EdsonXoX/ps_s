local function getPetLevel(petData, hatsData)
	local lvl = petData.l
	if petData.h then
		for _, hat in pairs(hatsData) do
			if hat.id == petData.h then
				lvl = lvl + hat.l
				break
			end
		end
	end
	return lvl
end

local function getPetsToFarm()
	local Stats = workspace.__REMOTES.Core["Get Stats"]:InvokeServer()
	local petsToUse = {}
	
	for i, pet in pairs(Stats.Save.Pets) do
		if mode == 0 or (mode == 1 and selected_Pets[pet.id]) then
			table.insert(petsToUse, {
				id = pet.id,
				lvl = getPetLevel(pet, Stats.Save.Hats)
			})
		end
	end
	return petsToUse
end

local function startFarming()
	if FARMING then return end
	FARMING = true
	equippedPets = getPetsToFarm()

	task.spawn(function()
		while FARMING do
			if math.random(100) == 1 or #equippedPets == 0 then
				equippedPets = getPetsToFarm()
			end

			local now = os.clock()

			if attackMode == 0 then
				if not currentCoin or not currentCoin.Parent or currentCoin.Parent ~= workspace.__THINGS.Coins then
					currentCoin = nil
					for i, v in pairs(workspace.__THINGS.Coins:GetChildren()) do
						local cn = v:FindFirstChild('CoinName')
						if cn and table.find(mineCoins, cn.Value) then
							currentCoin = v
							break
						end
					end
					if not currentCoin then task.wait(0.5) end
				end

				if currentCoin and currentCoin.Parent == workspace.__THINGS.Coins then
					local cn = currentCoin:FindFirstChild('CoinName')
					if cn and table.find(mineCoins, cn.Value) and now > lastMineCooldown + COOLDOWN then
						for _, pet in pairs(equippedPets) do
							workspace.__REMOTES.Game.Coins:FireServer("Mine", currentCoin.Name, pet.lvl * 2 - 1, pet.id)
						end
						lastMineCooldown = now
					end
				end

			else
				local availableCoins = {}
				for _, v in pairs(workspace.__THINGS.Coins:GetChildren()) do
					local cn = v:FindFirstChild('CoinName')
					if cn and table.find(mineCoins, cn.Value) then
						table.insert(availableCoins, v)
					end
				end

				if #availableCoins > 0 and now > lastMineCooldown + COOLDOWN then
					local coinIndex = 1
					for _, pet in pairs(equippedPets) do
						local assignedCoin = availableCoins[coinIndex]
						if assignedCoin then
							workspace.__REMOTES.Game.Coins:FireServer("Mine", assignedCoin.Name, pet.lvl * 2 - 1, pet.id)
							
							coinIndex = coinIndex + 1
							if coinIndex > #availableCoins then
								coinIndex = 1
							end
						end
					end
					lastMineCooldown = now
				end
			end

			task.wait(LOOP_WAIT)
		end
	end)
end

local function stopFarming()
	FARMING = false
end

if AUTO_REJOIN then
	local ts = game:GetService("TeleportService")
	task.spawn(function()
		while true do
			task.wait(REJOIN_INTERVAL)
			if FARMING and LocalPlayer and LocalPlayer.Parent then
				if #Players:GetPlayers() <= 1 then
					LocalPlayer:Kick("\nRejoining...")
					task.wait(1)
					ts:Teleport(game.PlaceId, LocalPlayer)
				else
					pcall(function() ts:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer) end)
				end
			end
		end
	end)
end

